{
  "name": "@dave/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for dave",
  "bin": {
    "dave": "./dist/dave.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/dave.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/dave-cli run build --filter=!@dave/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@dave/adapters": "workspace:*",
    "@dave/bootstrap": "workspace:*",
    "@dave/contracts": "workspace:*",
    "@dave/core": "workspace:*",
    "@dave/dynamic-workflow-runtime": "workspace:*",
    "@dave/i18n": "workspace:*",
    "@dave/provider-node": "workspace:*",
    "@dave/shared": "workspace:*",
    "@dave/shared-types": "workspace:*",
    "@dave/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
