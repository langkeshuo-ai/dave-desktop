{
  "name": "dave-desktop",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Dave Desktop — 戴夫个人 Agent 桌面应用",
  "author": "戴夫",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/alchaincyf/dave-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchaincyf/dave-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:electron": "npm run build && node tests/electron-smoke.mjs",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.7",
    "diff": "^9.0.0",
    "electron-log": "^5.0.0",
    "electron-store": "^11.0.0",
    "electron-updater": "^6.0.0",
    "electron-window-state": "^5.0.0",
    "execa": "^10.0.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "js-tiktoken": "^1.0.21",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "ulid": "^3.0.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.6",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
