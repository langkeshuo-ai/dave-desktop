{
  "name": "dave-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Dave Desktop — 戴夫个人 Agent 桌面应用",
  "author": "戴夫",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/alchaincyf/dave-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchaincyf/dave-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "electron-log": "^5.0.0",
    "electron-store": "^11.0.0",
    "electron-updater": "^6.0.0",
    "electron-window-state": "^5.0.0",
    "execa": "^10.0.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.500.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "ulid": "^3.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
